{
  "name": "atlas-abrasives-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/tail-in.css -o ./assets/css/tail-out.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/tail-in.css -o ./assets/css/tail-out.css --watch",
    "dev": "hugo server -D",
    "build": "npm run build:css && hugo --minify"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.18"
  }
}
